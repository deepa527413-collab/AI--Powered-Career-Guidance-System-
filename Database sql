CREATE DATABASE career_guidance;

USE career_guidance;

CREATE TABLE users(

id INT AUTO_INCREMENT PRIMARY KEY,

name VARCHAR(100),

email VARCHAR(100),

password VARCHAR(100)

);

CREATE TABLE careers(

id INT AUTO_INCREMENT PRIMARY KEY,

career_name VARCHAR(100),

required_skills TEXT,

description TEXT

);

