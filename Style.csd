body{
font-family:Arial,sans-serif;
background:#f4f4f4;
}

.navbar{
margin-bottom:20px;
}

.card{
border-radius:15px;
}

.btn{
border-radius:10px;
}

footer{
margin-top:40px;
}

h1,h2,h3,h4{
font-weight:bold;
}

.hero{
padding:60px;
text-align:center;
}

.card:hover{
transform:scale(1.03);
transition:.3s;
}

input{
border-radius:8px;
}

textarea{
border-radius:8px;
}
